{
  "$schema": "../plugin.schema.json",
  "schemaVersion": 1,
  "id": "dingtalk",
  "name": "钉钉文档",
  "description": "导入或导出钉钉文档，保留目录层级，并处理 Markdown 本地图片。",
  "version": "1.0.4",
  "publisher": "Wandao Official",
  "homepage": "https://docs.dingtalk.com/",
  "license": "AGPL-3.0-only",
  "core": { "minVersion": "1.3.5" },
  "platforms": ["win32", "darwin"],
  "entrypoints": {
    "providers": ["providers/dingtalk-export/provider.json", "providers/dingtalk-import/provider.json"]
  },
  "permissions": [
    "browser-automation",
    "credentials",
    "filesystem:write",
    "network",
    "process"
  ]
}
